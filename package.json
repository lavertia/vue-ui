{
  "name": "@lavertia/vue-ui",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "description": "Vue 3 UI rendering for Lavertia",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@lavertia/ui": "github:lavertia/ui#main"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "vue": "^3.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  }
}
